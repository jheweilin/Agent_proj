# copy to .env and fill in
WEB_PORT=8600
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://plasma:change-me@postgres:5432/plasma
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-long-random
ALLOW_REGISTRATION=1

# Amazon Bedrock (credentials come from the mounted ~/.aws)
AWS_CONFIG_DIR=/home/jhewlin/.aws
AWS_REGION=ap-southeast-1
MODEL=global.anthropic.claude-sonnet-5-5
FALLBACK_MODEL=global.anthropic.claude-opus-5-5
TITLE_MODEL=global.anthropic.claude-haiku-5-5
EFFORT=medium

# sandbox
SANDBOX_IMAGE=public.ecr.aws/z1o8z4f9/agent:plasma-1.1.0
SANDBOX_GPU=nvidia.com/gpu=0
SANDBOX_MEM=16g
SANDBOX_CPUS=12
SANDBOX_IDLE_MINUTES=120
WORKSPACES_DIR=/data/plasma-agent/workspaces
WORKER_CONCURRENCY=3

# external
COMSOL_API=http://140.134.138.17:2035/api/v1
TAVILY_API_KEY=

# knowledge base (Voyage AI embedding + rerank); leave VOYAGE_API_KEY empty to disable the KB
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2.5
EMBED_DIM=1024
